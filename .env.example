# Copy this file to .env and change these values.
PORT=3000
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
ADMIN_USERNAME=admin
# Generate a bcrypt hash with: node -e "console.log(require('bcryptjs').hashSync('YourStrongPassword', 12))"
ADMIN_PASSWORD_HASH=$2b$12$2hsxmMPW/efugnbdMlUsPeSYNamZ5ij9m.2V9hDlPSl8HmJ63FW8W

# Optional Messenger integration.
# Set these only after you have a Meta/Facebook Page and a valid Page access token.
MESSENGER_PAGE_ID=
MESSENGER_PAGE_ACCESS_TOKEN=
